# Required: Langfuse API credentials
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Optional: Langfuse instance URL (default: https://cloud.langfuse.com)
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: Enable prompt tools (default: false)
# Set to true if you want prompt management tools included
# Note: The official Langfuse MCP server already provides prompt tools
MCP_ENABLE_PROMPTS=false

# Optional: Log level (default: info)
# Options: debug, info, warn, error
LOG_LEVEL=info
